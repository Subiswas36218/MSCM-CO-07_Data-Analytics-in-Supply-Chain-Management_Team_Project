# ---------- macOS ----------
.DS_Store
.AppleDouble
.LSOverride
._*

# ---------- Windows ----------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

